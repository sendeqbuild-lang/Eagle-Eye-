rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------
    // HELPERS
    // ---------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && 
             request.auth.token.email_verified == true && (
        request.auth.token.email == "sendeqbuild@gmail.com" ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // ---------------------------------------------------------
    // TARGETS COLLECTION
    // ---------------------------------------------------------
    function isValidTarget(data) {
      let requiredFields = ['name', 'lastSeen', 'status'];
      return data.keys().hasAll(requiredFields) &&
             data.name is string && data.name.size() <= 100 &&
             data.lastSeen is string &&
             data.status in ['active', 'offline', 'warning'] &&
             (!data.keys().hasAll(['lat']) || data.lat is number) &&
             (!data.keys().hasAll(['lng']) || data.lng is number) &&
             (!data.keys().hasAll(['accuracy']) || data.accuracy is number) &&
             (!data.keys().hasAll(['platform']) || data.platform is string) &&
             (!data.keys().hasAll(['history']) || data.history is list) &&
             (!data.keys().hasAll(['intel']) || data.intel is list) &&
             (!data.keys().hasAll(['ipInfo']) || data.ipInfo is map) &&
             (!data.keys().hasAll(['deviceInfo']) || data.deviceInfo is map);
    }

    match /targets/{targetId} {
      allow get: if isAdmin() || (isSignedIn() && request.auth.uid == targetId);
      allow list: if isAdmin();
      
      allow create: if isValidId(targetId) && isValidTarget(incoming());
      
      allow update: if (isValidId(targetId) && (
        isAdmin() ||
        (
          isValidTarget(incoming()) && (
            // Added ipInfo and deviceInfo to the allowed update keys
            incoming().diff(existing()).affectedKeys().hasOnly(['lat', 'lng', 'accuracy', 'lastSeen', 'status', 'history', 'intel', 'platform', 'ipInfo', 'deviceInfo'])
          )
        )
      ));
    }

    match /admins/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    match /_connection_test_/{docId} {
      allow read: if true;
    }
  }
}
