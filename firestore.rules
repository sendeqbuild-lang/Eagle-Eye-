rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------
    // HELPERS
    // ---------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.uid == "oY4YurvEZRRmGoZSREVN9eInT7D3" ||
        request.auth.token.email == "sendeqbuild@gmail.com"
      );
    }

    function isValidId(id) {
      // Standard Firebase UIDs are alphanumeric string and can be up to 128 chars.
      // Usually they match [a-zA-Z0-9_\-]+
      return id is string && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // ---------------------------------------------------------
    // TARGETS COLLECTION
    // ---------------------------------------------------------
    function isValidTarget(data) {
      // Identity and Status (Verified on creation, checked if present on update)
      return (!data.keys().hasAll(['name']) || (data.name is string && data.name.size() <= 100)) &&
             (!data.keys().hasAll(['lastSeen']) || data.lastSeen is string) &&
             (!data.keys().hasAll(['status']) || data.status in ['active', 'offline', 'warning']) &&
             (!data.keys().hasAll(['lat']) || data.lat is number) &&
             (!data.keys().hasAll(['lng']) || data.lng is number) &&
             (!data.keys().hasAll(['accuracy']) || data.accuracy is number) &&
             (!data.keys().hasAll(['platform']) || data.platform is string) &&
             (!data.keys().hasAll(['history']) || data.history is list) &&
             (!data.keys().hasAll(['intel']) || data.intel is list) &&
             (!data.keys().hasAll(['ipInfo']) || data.ipInfo is map) &&
             (!data.keys().hasAll(['deviceInfo']) || data.deviceInfo is map) &&
             (!data.keys().hasAll(['lastPing']) || data.lastPing is timestamp);
    }

    match /targets/{targetId} {
      // Allow anybody who knows the ID to get the target document
      allow get: if true;
      allow list: if isAdmin();
      
      allow create: if isValidId(targetId) && 
                      incoming().keys().hasAll(['name', 'lastSeen', 'status']) &&
                      isValidTarget(incoming());
      
      allow update: if (isValidId(targetId) && (
        isAdmin() ||
        (
          isSignedIn() && 
          request.auth.uid == targetId &&
          isValidTarget(incoming()) && (
            // Whitelist keys that a target can update (ipInfo, deviceInfo included)
            incoming().diff(existing()).affectedKeys().hasOnly(['name', 'lat', 'lng', 'accuracy', 'lastSeen', 'status', 'history', 'intel', 'platform', 'ipInfo', 'deviceInfo', 'lastPing'])
          )
        )
      ));
    }

    match /admins/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    match /_connection_test_/{docId} {
      allow read: if true;
    }
  }
}
